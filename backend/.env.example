# ==========================================================================
# Configuration videos-gen — copie ce fichier en `.env` et remplis ce que tu as.
# Tout est OPTIONNEL : sans aucune clé, le provider "demo" et "pollinations"
# fonctionnent quand même (gratuits, sans compte).
# ==========================================================================

# --- Amélioration de prompt (fortement recommandé pour le réalisme) ---
# Fournisseur LLM utilisé pour transformer un prompt simple en prompt cinéma.
# Valeurs possibles : "anthropic", "openai", "rule_based" (gratuit, sans clé)
PROMPT_ENHANCER=rule_based
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Providers de génération vidéo (tous optionnels) ---

# fal.ai — crédits gratuits à l'inscription, accès à Kling, Luma, Wan, LTX...
# https://fal.ai/dashboard/keys
FAL_KEY=

# Replicate — crédits gratuits, catalogue de modèles vidéo open-source
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# ComfyUI local (open-source, gratuit, nécessite un GPU)
# URL de ton serveur ComfyUI, ex: http://127.0.0.1:8188
COMFYUI_URL=

# --- Serveur ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
