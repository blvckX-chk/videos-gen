# Caddy — terminaison TLS automatique (Let's Encrypt) devant KORA.
# DOMAIN et ACME_EMAIL viennent de l'environnement (voir docker-compose.prod.yml).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	# Uploads volumineux (PDF, vidéos) — aligne avec nginx (50 Mo).
	request_body {
		max_size 50MB
	}
	reverse_proxy web:80
}
